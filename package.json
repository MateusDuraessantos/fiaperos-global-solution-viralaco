{
  "name": "fiaperos-global-solution-viralaco",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "env:setup": "node scripts/setup-env.mjs",
    "setup:dev": "pnpm env:setup && pnpm db:generate",
    "dev": "pnpm --parallel --stream --filter @viralaco/* dev",
    "dev:web": "pnpm --filter @viralaco/web dev",
    "dev:api": "pnpm --filter @viralaco/api dev",
    "build": "pnpm -r build",
    "start:api": "pnpm --filter @viralaco/api start",
    "preview:web": "pnpm --filter @viralaco/web preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test:smoke": "node scripts/smoke.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:check": "pnpm --filter @viralaco/api prisma:check",
    "db:generate": "pnpm --filter @viralaco/api prisma:generate",
    "db:validate": "pnpm --filter @viralaco/api prisma:validate",
    "db:format": "pnpm --filter @viralaco/api prisma:format",
    "db:migrate": "pnpm --filter @viralaco/api prisma:migrate",
    "db:deploy": "pnpm --filter @viralaco/api prisma:deploy",
    "db:studio": "pnpm --filter @viralaco/api prisma:studio"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vue-eslint-parser": "10.4.2"
  }
}
